{
  "name": "weparty-automation",
  "version": "1.0.0",
  "description": "Testes automatizados E2E do WeParty com Cypress",
  "main": "index.js",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('cypress/reports', {recursive:true, force:true})\"",
    "cy:open": "cypress open",
    "cy:run": "node scripts/run-tests.js",
    "cy:run:login": "node scripts/run-tests.js --spec \"cypress/e2e/public/login.cy.js\"",
    "cy:run:feed": "node scripts/run-tests.js --spec \"cypress/e2e/private/feed.cy.js\"",
    "cy:run:top-eventos": "node scripts/run-tests.js --spec \"cypress/e2e/private/top-eventos.cy.js\"",
    "cy:run:detalhes": "node scripts/run-tests.js --spec \"cypress/e2e/private/detalhes.cy.js\"",
    "cy:run:signup": "node scripts/run-tests.js --spec \"cypress/e2e/signup.cy.js\"",
    "test": "node scripts/run-tests.js",
    "report:merge": "mochawesome-merge \"cypress/reports/mochawesome*.json\" -o cypress/reports/merged-report.json",
    "report:generate": "node scripts/generate-report.js",
    "report": "npm run report:merge && npm run report:generate",
    "test:report": "npm run test && npm run report",
    "cy:run:cms": "cypress run --spec \"cypress/e2e/cms/cms-*-layout.cy.js,cypress/e2e/cms/cms-seguranca.cy.js,cypress/e2e/cms/cms-admin-shell.cy.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-tech-git/weparty-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/we-tech-git/weparty-automation/issues"
  },
  "homepage": "https://github.com/we-tech-git/weparty-automation#readme",
  "devDependencies": {
    "cypress": "^15.20.0",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1"
  }
}
